                    <mxGeometry x="600" y="40" width="370" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="falco-box" value="Falco (DaemonSet, eBPF/modern_ebpf)&#xa;Runtime threat detection&#xa;Rule: Container Running as Root → WARN&#xa;Rule: Root Process in User NS → CRIT&#xa;falcosidekick for event forwarding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="falco-ns" vertex="1">
